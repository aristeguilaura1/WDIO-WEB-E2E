{
  "name": "WDIO-WEB-E2E",
  "type": "module",
  "devDependencies": {
    "@testing-library/webdriverio": "^3.2.1",
    "@types/node": "^25.2.1",
    "@wdio/allure-reporter": "^9.23.3",
    "@wdio/cli": "^9.23.3",
    "@wdio/cucumber-framework": "^9.23.3",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.23.3",
    "@wdio/spec-reporter": "^9.23.3",
    "expect-webdriverio": "^5.6.4",
    "wdio-wait-for": "^3.1.1"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "test": "wdio run ./wdio.conf.ts && npm run allure:generate",
    "test:blazedemo": "wdio run ./wdio.conf.ts --spec=\"./features/blazedemo-csv.feature\" && npm run allure:generate",
    "test:csv": "wdio run ./wdio.conf.ts --spec=\"./features/blazedemo-csv.feature\"",
    "test:debug": "wdio run ./wdio.conf.ts --spec=\"./features/blazedemo-simple.feature\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "test:report": "npm run test && npm run allure:open"
  }
}
